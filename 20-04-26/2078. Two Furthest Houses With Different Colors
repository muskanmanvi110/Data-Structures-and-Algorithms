Approach - 01
class Solution {
    public int maxDistance(int[] colors) {
        int n = colors.length;
        int max_dist = 0;
        for(int i = 0; i < n; i++){
            int color = colors[i];
            for(int j = i + 1; j<n; j++){
                if(color != colors[j]){
                    max_dist = Math.max(max_dist, j - i);
                }
            }
        }

        return max_dist;
    }
}

Approach - 02

class Solution {
    public int maxDistance(int[] colors) {
        int n = colors.length;
        int max_dist = 0;
        
        for(int i = 0; i<n; i++){
            if(colors[i] != colors[n - 1]){
                max_dist = (n - 1) - i;
                break;
            }
        }

        for(int i = n - 1; i >= 0; i--){
            if(colors[i] != colors[0]){
                max_dist = Math.max(max_dist, i);
            }
        }

        return max_dist;
    }
}
