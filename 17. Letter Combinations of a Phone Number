17. Letter Combinations of a Phone Number

class Solution {
    public List<String> letterCombinations(String digits) {
        HashMap<Character, String> map = new HashMap<>();
        map.put('2', "abc");
        map.put('3', "def");
        map.put('4', "ghi");
        map.put('5', "jkl");
        map.put('6', "mno");
        map.put('7', "pqrs");
        map.put('8', "tuv");
        map.put('9', "wxyz");
        int n = digits.length();
        StringBuilder sb = new StringBuilder();
        List<String> ans = new ArrayList<>();
        solve(0, digits, n, sb, ans, map);
        return ans;
    }

    public static void solve(int i, String digits, int n, StringBuilder sb, List<String> ans, HashMap<Character, String> map){
        if(i >= n){
            ans.add(sb.toString());
            return;
        }

        String letters = map.get(digits.charAt(i));

        for(char ch : letters.toCharArray()){
            sb.append(ch);
            solve(i + 1, digits, n, sb, ans, map);
            sb.deleteCharAt(sb.length() - 1);
        }

    }
}
