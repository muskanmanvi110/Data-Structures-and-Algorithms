APPROACH - 01

class Solution {
    public List<String> validStrings(int n) {
        List<String> ans = new ArrayList<>();
        StringBuilder sb = new StringBuilder();
        solve(n, sb, ans);
        return ans;
    }
    public static void solve(int n, StringBuilder sb, List<String> ans){
        if(sb.length() == n){
            if(isValid(sb.toString())){
                ans.add(sb.toString());
            }
            return;
        }
        sb.append('0');
        solve(n, sb, ans);
        sb.deleteCharAt(sb.length() - 1);

        sb.append('1');
        solve(n, sb, ans);
        sb.deleteCharAt(sb.length() - 1);
    }

    public static boolean isValid(String s){
        int n = s.length();
        for(int i = 0; i < n-1; i++){
            if(s.charAt(i) == '0' && s.charAt(i + 1) == '0'){
                return false;
            }
        }
        return true;
    }
}


APPROACH - 02

class Solution {
    public List<String> validStrings(int n) {
        List<String> ans = new ArrayList<>();
        StringBuilder sb = new StringBuilder();
        solve(n, sb, ans, false);
        return ans;
    }
    public static void solve(int n, StringBuilder sb, List<String> ans, boolean zero){
        if(sb.length() == n){
            ans.add(sb.toString());
            return;
        }
        
        if(!zero){
            sb.append('0');
            solve(n, sb, ans, true);
            sb.deleteCharAt(sb.length() - 1);
        }

        sb.append('1');
        solve(n, sb, ans, false);
        sb.deleteCharAt(sb.length() - 1);
    }
}
