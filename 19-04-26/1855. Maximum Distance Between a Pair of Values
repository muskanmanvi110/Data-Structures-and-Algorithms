Approach - 01

class Solution {
    public int maxDistance(int[] nums1, int[] nums2) {
        int n = nums1.length;
        int max = Integer.MIN_VALUE;
        for(int i = 0; i<n; i++){
            int j = binarySearch(nums2, nums1[i]);
            if(i <= j){
                int dist = j - i;
                max = Math.max(max, dist);
            }
        }
        if(max == Integer.MIN_VALUE) return 0;
        return max;
    }

    public static int binarySearch(int[] nums2, int target){
        int low = 0;
        int high = nums2.length - 1;
        int ans = -1;
        while(low <= high){
            int mid = (low + high) / 2;
            if(nums2[mid] >= target){
                ans = mid;
                low = mid + 1;
            }else{
                high = mid - 1;
            }
        }

        return ans;
    }
}

Approach - 02

class Solution {
    public int maxDistance(int[] nums1, int[] nums2) {
        int n = nums1.length;
        int m = nums2.length;
        int max = Integer.MIN_VALUE;
        
        int i = 0;
        int j = 0;

        while(i < n){
            while(j < m && nums1[i] <= nums2[j]){
                if(i <= j){
                    int dist = j - i;
                    max = Math.max(max, dist);
                }
                j++;
            }
            i++;
        }


        if(max == Integer.MIN_VALUE) return 0;
        return max;
    }
}
