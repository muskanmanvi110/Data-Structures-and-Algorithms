3488. Closest Equal Element Queries

class Solution {
    public List<Integer> solveQueries(int[] nums, int[] queries) {
        HashMap<Integer, ArrayList<Integer>> map = new HashMap<>();
        List<Integer> ans = new ArrayList<>();
        int n = nums.length;
        for(int i = 0; i<n; i++){
            if(!map.containsKey(nums[i])){
                map.put(nums[i], new ArrayList<>());
            }
            map.get(nums[i]).add(i);
        }

        for(int q : queries){
            int res = Integer.MAX_VALUE;
            int ele = nums[q];
            ArrayList<Integer> arr = map.get(ele);

            if(arr.size() == 1){
                ans.add(-1);
                continue;
            } 
            
            int pos = binarySearch(arr, q);
            int size = arr.size();

            //right position
            int right = arr.get((pos + 1) % size);
            int s_dist = Math.abs(q - right);
            int cir_dist = n - s_dist;
            res = Math.min(s_dist, cir_dist);
            
            //left position
            int left = arr.get((pos - 1 + size) % size);
            s_dist = Math.abs(q - left);
            cir_dist = n - s_dist;
            res = Math.min(res, Math.min(s_dist, cir_dist));

            ans.add(res);

        }

        return ans;
    }

    public static int binarySearch(ArrayList<Integer> arr, int q){
        int low = 0;
        int high = arr.size() - 1;
        while(low <= high){
            int mid = (low + high) / 2;
            int ele = arr.get(mid);
            if(ele == q) return mid;
            else if(ele < q) low = mid + 1;
            else if(ele > q) high = mid - 1;
        }

        return -1;
    }
}
